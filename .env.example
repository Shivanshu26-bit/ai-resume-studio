# ==========================================
# SERVER-ONLY ENVIRONMENT VARIABLES
# (Never expose to client / browser bundle)
# ==========================================

# Required: Gemini API Key for server-side AI resume enhancement & ATS analysis
GEMINI_API_KEY=

# Optional: Server Port (defaults to 3000 or Cloud Run injected PORT)
PORT=3000

# Optional: Production Node Environment
NODE_ENV=production

# ==========================================
# CLIENT-SAFE ENVIRONMENT VARIABLES
# (Firebase Client SDK configuration)
# ==========================================
# Loaded automatically from firebase-applet-config.json by default.
# If configured via environment variables:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

